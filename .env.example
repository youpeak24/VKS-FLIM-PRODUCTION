# Copy to .env and fill in. All values are optional.

# Production URL (no trailing slash), e.g. https://www.example.com
# Enables canonical URLs, absolute Open Graph image URLs and sitemap.xml.
# Leave empty until the client confirms the domain.
VITE_SITE_URL=

# Optional third-party form endpoint that accepts JSON POST (e.g. Formspree:
# https://formspree.io/f/xxxxxxx). When empty, the contact form uses a mailto:
# hand-off and opens the visitor's own email app instead.
VITE_FORM_ENDPOINT=
