# Copy to .env (local) and fill in. For production, add the same variables in
# Vercel -> Project -> Settings -> Environment Variables, then redeploy.

# ── Public (exposed to the browser) ───────────────────────────────────────────
# NOTE: the production domain (https://www.vksflim.com) is fixed in src/data/company.js and drives the
# canonical URLs, Open Graph URLs, JSON-LD and sitemap.xml. VITE_SITE_URL is no longer used.

# Optional override for the contact form endpoint. Leave empty to use the
# built-in serverless function at /api/contact.
VITE_FORM_ENDPOINT=

# ── Contact form (server-only, used by api/contact.js) ────────────────────────
# SMTP server used by nodemailer to send the mail.
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#           SMTP_PASS must be a 16-character Google "App password"
#           (Google Account -> Security -> 2-Step Verification -> App passwords).
#   Other:  use the SMTP details from your email host (Zoho, Outlook, Brevo, ...).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where inquiries are delivered (the owner's inbox).
CONTACT_TO_EMAIL=

# Optional. "From" address on the delivered mail. Defaults to SMTP_USER.
# Most providers only allow an address that belongs to the SMTP account.
CONTACT_FROM_EMAIL=

# Optional. Name shown in the delivered mail. Defaults to "VKS Film Production".
SITE_NAME=
